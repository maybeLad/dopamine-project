<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
	id="WebApp_ID" version="5.0">
	<display-name>dopamine-project</display-name>
	<welcome-file-list>
		<welcome-file>welcome</welcome-file>
	</welcome-file-list>


	<!-- Servlet -->
	<servlet>
		<servlet-name>WelcomeServlet</servlet-name>
		<servlet-class>it.dopamine.controller.WelcomeServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>LoginServlet</servlet-name>
		<servlet-class>it.dopamine.controller.LoginServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>SignupServlet</servlet-name>
		<servlet-class>it.dopamine.controller.SignupServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>CatalogueServlet</servlet-name>
		<servlet-class>it.dopamine.controller.CatalogueServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>InfoServlet</servlet-name>
		<servlet-class>it.dopamine.controller.InfoServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>ProductPageServlet</servlet-name>
		<servlet-class>it.dopamine.controller.ProductPageServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>ReviewServlet</servlet-name>
		<servlet-class>it.dopamine.controller.ReviewServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>UserPageServlet</servlet-name>
		<servlet-class>it.dopamine.controller.UserPageServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>NewsServlet</servlet-name>
		<servlet-class>it.dopamine.controller.NewsServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>ChangePasswordServlet</servlet-name>
		<servlet-class>it.dopamine.controller.ChangePasswordServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>ChangeAddressServlet</servlet-name>
		<servlet-class>it.dopamine.controller.ChangeAddressServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>SetAddressServlet</servlet-name>
		<servlet-class>it.dopamine.controller.SetAddressServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>ChangePaymentMethodServlet</servlet-name>
		<servlet-class>it.dopamine.controller.ChangePaymentMethodServlet</servlet-class>
	</servlet>
	
	<servlet>
    	<servlet-name>SearchServlet</servlet-name>
    	<servlet-class>it.dopamine.controller.SearchServlet</servlet-class>
	</servlet>

	<!-- Mapping -->
	<servlet-mapping>
		<servlet-name>WelcomeServlet</servlet-name>
		<url-pattern>/welcome</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>LoginServlet</servlet-name>
		<url-pattern>/login</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>SignupServlet</servlet-name>
		<url-pattern>/signup</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>CatalogueServlet</servlet-name>
		<url-pattern>/catalogue</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>InfoServlet</servlet-name>
		<url-pattern>/info</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>ProductPageServlet</servlet-name>
		<url-pattern>/productPage</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>ReviewServlet</servlet-name>
		<url-pattern>/reviews</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>UserPageServlet</servlet-name>
		<url-pattern>/user</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>NewsServlet</servlet-name>
		<url-pattern>/news</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>ChangePasswordServlet</servlet-name>
		<url-pattern>/changePassword</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>ChangeAddressServlet</servlet-name>
		<url-pattern>/changeAddress</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>SetAddressServlet</servlet-name>
		<url-pattern>/setAddress</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>ChangePaymentMethodServlet</servlet-name>
		<url-pattern>/changePaymentMethod</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
    	<servlet-name>SearchServlet</servlet-name>
    	<url-pattern>/search</url-pattern>
	</servlet-mapping>
	
	

	<resource-ref>
		<res-ref-name>jdbc/dopamine</res-ref-name>
		<res-type>javax.sql.DataSource</res-type>
		<res-auth>Container</res-auth>
	</resource-ref>
	
	
	
	<error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/error_pages/error404.jsp</location>
	</error-page>
	
	<error-page>
	    <error-code>500</error-code>
	    <location>/WEB-INF/views/error_pages/error500.jsp</location>
	</error-page>
	
	<error-page>
    	<location>/WEB-INF/views/error_pages/general_error.jsp</location>
	</error-page>

</web-app>